#!/usr/bin/env bash
set -euo pipefail

APP=/opt/app
user="${KELLINGRAD_USER:-${USER:-$(id -un)}}"

build_generation() {
  nix-build --no-out-link --argstr user "${user}" --expr '
    { user, system ? builtins.currentSystem }:
    let
      sources = import /opt/app/hm-base/npins;
      pkgs = import sources.nixpkgs {
        localSystem.system = system;
        config.allowUnfree = true;
        overlays = [ (import /opt/app/overlay.nix) ];
      };
    in
    if user == "root" then
      (import /opt/app/nix-base {
        inherit pkgs sources;
        overlays = [ /opt/app/nix/system.nix ];
      }).generation
    else
      let home-manager = import sources.home-manager { inherit pkgs; };
      in (home-manager.lib.homeManagerConfiguration {
        inherit pkgs;
        modules = [
          (/opt/app/hm-user + ("/" + user + "/home.nix"))
          {
            home.username = user;
            home.homeDirectory = "/home/" + user;
          }
        ];
      }).activationPackage
  '
}

if (( $# != 0 )); then
  echo 'usage: refresh-system' >&2
  exit 2
fi

if [[ "${user}" = "root" ]]; then
  current_uid=$(id -u)
  if [[ "${current_uid}" != "0" ]]; then
    echo "refresh-system: the system configuration can only be refreshed as root" >&2
    exit 1
  fi

  system_nix="${APP}/nix/system.nix"
  if [[ ! -f "${system_nix}" ]]; then
    echo "refresh-system: no system.nix found at ${system_nix}" >&2
    exit 1
  fi

  profile="/nix/var/nix/profiles/system"
  export HOME="${HOME:-/root}"
  if [[ -S /nix/var/nix/daemon-socket/socket ]]; then
    export NIX_REMOTE=daemon
  fi

  result=$(build_generation)
  mkdir -p "${profile%/*}"
  nix-env -p "${profile}" --set "${result}"
  exec "${result}/bin/apply"
fi

home_nix="${APP}/hm-user/${user}/home.nix"
managed_nix="${APP}/hm-user/${user}/managed.nix"

if [[ ! -f "${home_nix}" ]]; then
  echo "refresh-system: no home.nix found at ${home_nix}" >&2
  exit 1
fi

if [[ ! -f "${managed_nix}" ]]; then
  echo "refresh-system: no managed.nix found at ${managed_nix}; run write-managed-hm --reset" >&2
  exit 1
fi

result=$(build_generation)

"${result}/activate"
