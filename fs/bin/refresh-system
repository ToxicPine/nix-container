#!/usr/bin/env bash
set -euo pipefail

APP=/opt/app
user="${SYSTEM_IMAGE_USER:-${USER:-$(id -un)}}"

build_generation() {
  nix-build --no-out-link --argstr user "${user}" --expr '
    { user, system ? builtins.currentSystem }:
    let
      sources = import /opt/app/hm-base/npins;
      pkgs = import sources.nixpkgs {
        localSystem.system = system;
        config.allowUnfree = true;
        overlays = [ (import /opt/app/overlay.nix) ];
      };
    in
    if user == "root" then
      (import /opt/app/scaffold {
        inherit pkgs sources;
        overlays = [ /opt/app/nix/system.nix ];
      }).generation
    else
      let home-manager = import sources.home-manager { inherit pkgs; };
      in (home-manager.lib.homeManagerConfiguration {
        inherit pkgs;
        modules = [
          (/opt/app/hm-user + ("/" + user + "/home.nix"))
          {
            home.username = user;
            home.homeDirectory = "/home/" + user;
          }
        ];
      }).activationPackage
  '
}

if (( $# != 0 )); then
  echo 'usage: refresh-system' >&2
  exit 2
fi

if [[ "${user}" = "root" ]]; then
  current_uid=$(id -u)
  if [[ "${current_uid}" != "0" ]]; then
    echo "refresh-system: the system configuration can only be refreshed as root" >&2
    exit 1
  fi

  system_nix="${APP}/nix/system.nix"
  if [[ ! -f "${system_nix}" ]]; then
    echo "refresh-system: no system.nix found at ${system_nix}" >&2
    exit 1
  fi

  profile="/nix/var/nix/profiles/system"
  export HOME="${HOME:-/root}"
  if [[ -S /nix/var/nix/daemon-socket/socket ]]; then
    export NIX_REMOTE=daemon
  fi

  result=$(build_generation)
  # Keep the saved profile and live application in the same critical section.
  # The generation's apply command inherits the lock instead of reacquiring it.
  exec s6-setlock -w /run/nix-supervise/system/apply.lock \
    env SYSTEM_IMAGE_APPLY_LOCKED=1 bash -c '
      set -euo pipefail
      profile=$1
      result=$2
      mkdir -p "${profile%/*}"
      nix-env -p "${profile}" --set "${result}"
      exec "${result}/bin/apply"
    ' refresh-system "${profile}" "${result}"
fi

home_nix="${APP}/hm-user/${user}/home.nix"

if [[ ! -f "${home_nix}" ]]; then
  echo "refresh-system: no home.nix found at ${home_nix}" >&2
  exit 1
fi


# Home Manager activation applies services into this user's supervision tree,
# which only exists for accounts declared in the system configuration. Refuse
# before building rather than failing after activation's write boundary.
tree_runtime="/run/nix-supervise/users/$(id -u)"
if [[ ! -d "${tree_runtime}" || "$(stat -c %u "${tree_runtime}")" != "$(id -u)" ]]; then
  echo "refresh-system: ${user} has no supervision tree at ${tree_runtime}" >&2
  echo "refresh-system: declare the account in /data/system/nixcfg/system.nix and run refresh-system as root" >&2
  exit 1
fi

result=$(build_generation)

"${result}/activate"
